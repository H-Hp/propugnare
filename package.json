{
  "name": "propugnare",
  "private": true,
  "dependencies": {
    "@rails/actioncable": "^6.0.0",
    "@rails/activestorage": "^6.0.0",
    "@rails/ujs": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.18.6",
    "esbuild": "^0.25.8"
  },
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "build": "esbuild app/javascript/application.js app/javascript/matching.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.js=jsx --loader:.jsx=jsx --loader:.png=file --loader:.jpg=file --loader:.jpeg=file --loader:.gif=file --loader:.svg=file",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify"
  }
}
