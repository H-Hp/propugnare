<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/draggable@4.2.0/dist/draggable.min.js"></script>
<div id="lobby-container" data-session-id="<%= session.id.to_s %>" data-all-gameroomdatas="<%= @game_room_datas %>" data-logo-path="<%= image_path('Logo.png') %>" data-loadingimg-path="<%= image_path('game_back.gif') %>" data-gameback-path="<%= image_path('game_back5.gif') %>" ></div>
<%= javascript_include_tag "matching", defer: true, type: "module" %>
