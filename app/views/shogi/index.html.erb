<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/draggable@4.2.0/dist/draggable.min.js"></script>
<%= stylesheet_link_tag 'shogi', media: 'all' %>
<%= stylesheet_link_tag 'ShogiTimer', media: 'all' %>
<%= stylesheet_link_tag 'chat', media: 'all' %>
<!-- react-rails というGemが提供するヘルパーメソッド react_component・shogi/indexはコンポーネント名でもいい・例えばShogiとか・2つ目の引数はわたす値・3つ目の引数レンダリングオプション（例：prerender: falseはサーバーサイドレンダリングを無効にする）-->
<%= react_component("shogi/index", {gameId: @game_id}) %>
<div id="game-container" 
  data-game-room-data=" <%= @game_room_data_json %>" 
  data-logo-path="<%= image_path('Logo.png') %>" 
  data-loadingimg-path="<%= image_path('game_back.gif') %>" 
  data-gameback-path="<%= image_path('game_back6.gif') %>" 
  data-game-id="<%= @game_id %>" 
  data-room-id="<%= @room_id %>" 
  data-your-role="<%= @your_role %>"  
  data-enemy-role="<%= @enemy_role %>" 
  data-audience-user="<%= @audienceUser %>"

  data-king-path="<%= image_path('shogi/king.png') %>"
  data-gyoku-path="<%= image_path('shogi/king2.png') %>"
  data-rook-path="<%= image_path('shogi/rook.png') %>"
  data-bishop-path="<%= image_path('shogi/bishop.png') %>"
  data-gold-path="<%= image_path('shogi/gold.png') %>"
  data-silver-path="<%= image_path('shogi/silver.png') %>"
  data-knight-path="<%= image_path('shogi/knight.png') %>"
  data-lance-path="<%= image_path('shogi/lance.png') %>"
  data-pawn-path="<%= image_path('shogi/pawn.png') %>"
  data-dragon-path="<%= image_path('shogi/dragon.png') %>"
  data-horse-path="<%= image_path('shogi/horse.png') %>"
  data-prom_silver-path="<%= image_path('shogi/prom_silver.png') %>"
  data-prom_knight-path="<%= image_path('shogi/prom_knight.png') %>"
  data-prom_lance-path="<%= image_path('shogi/prom_lance.png') %>"
  data-prom_pawn-path="<%= image_path('shogi/prom_pawn.png') %>"
></div>